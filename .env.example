# Clio API Configuration

# Your Clio OAuth access token (required)
# Get this from Clio Developer Portal: https://app.clio.com/settings/developer_applications
CLIO_ACCESS_TOKEN=your-clio-access-token-here


# API Region: "eu" for eu.app.clio.com or "us" for app.clio.com
CLIO_REGION=eu

# Flask API Configuration
PORT=5000
DEBUG=False
