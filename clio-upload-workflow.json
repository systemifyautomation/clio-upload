{
  "name": "Clio Document Upload",
  "nodes": [
    {
      "parameters": {},
      "id": "e7e3e44e-bc34-4b54-ae22-5e5d5e5d5e5d",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
              "name": "filePath",
              "value": "={{ $json.filePath }}",
              "type": "string"
            },
            {
              "id": "b2c3d4e5-f6a7-4b5c-9d0e-1f2a3b4c5d6e",
              "name": "fileName",
              "value": "={{ $json.fileName }}",
              "type": "string"
            },
            {
              "id": "c3d4e5f6-a7b8-4c5d-0e1f-2a3b4c5d6e7f",
              "name": "matterId",
              "value": "={{ $json.matterId }}",
              "type": "number"
            },
            {
              "id": "d4e5f6a7-b8c9-4d5e-1f2a-3b4c5d6e7f8a",
              "name": "description",
              "value": "={{ $json.description || '' }}",
              "type": "string"
            },
            {
              "id": "e5f6a7b8-c9d0-4e5f-2a3b-4c5d6e7f8a9b",
              "name": "folderId",
              "value": "={{ $json.folderId || null }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "f6a7b8c9-d0e1-4f5a-3b4c-5d6e7f8a9b0c",
      "name": "Set Input Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 300],
      "notes": "Set the file path, matter ID, folder ID (optional), and description (optional)"
    },
    {
      "parameters": {
        "url": "=https://{{ $('Set Clio Credentials').item.json.region }}.app.clio.com/api/v4/documents.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "clioApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,latest_document_version{uuid,put_url,put_headers}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"name\": \"{{ $('Set Input Parameters').item.json.fileName }}\",\n    \"parent\": {\n      \"id\": {{ $('Set Input Parameters').item.json.folderId || $('Set Input Parameters').item.json.matterId }},\n      \"type\": \"{{ $('Set Input Parameters').item.json.folderId ? 'Folder' : 'Matter' }}\"\n    },\n    \"matter\": {\n      \"id\": {{ $('Set Input Parameters').item.json.matterId }}\n    }{{ $('Set Input Parameters').item.json.description ? ',\\n    \"description\": \"' + $('Set Input Parameters').item.json.description + '\"' : '' }}\n  }\n}",
        "options": {}
      },
      "id": "a7b8c9d0-e1f2-4a5b-4c5d-6e7f8a9b0c1d",
      "name": "Step 1 - Create Document Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "notes": "Creates a document record in Clio and gets the S3 upload URL"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b8c9d0e1-f2a3-4b5c-5d6e-7f8a9b0c1d2e",
              "name": "documentId",
              "value": "={{ $json.data.id }}",
              "type": "number"
            },
            {
              "id": "c9d0e1f2-a3b4-4c5d-6e7f-8a9b0c1d2e3f",
              "name": "uuid",
              "value": "={{ $json.data.latest_document_version.uuid }}",
              "type": "string"
            },
            {
              "id": "d0e1f2a3-b4c5-4d6e-7f8a-9b0c1d2e3f4a",
              "name": "putUrl",
              "value": "={{ $json.data.latest_document_version.put_url }}",
              "type": "string"
            },
            {
              "id": "e1f2a3b4-c5d6-4e7f-8a9b-0c1d2e3f4a5b",
              "name": "putHeaders",
              "value": "={{ $json.data.latest_document_version.put_headers }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "f2a3b4c5-d6e7-4f8a-9b0c-1d2e3f4a5b6c",
      "name": "Extract Upload Info",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "filePath": "={{ $('Set Input Parameters').item.json.filePath }}"
      },
      "id": "a3b4c5d6-e7f8-4a9b-0c1d-2e3f4a5b6c7d",
      "name": "Read Binary File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [900, 500]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $('Extract Upload Info').item.json.putUrl }}",
        "authentication": "none",
        "sendBody": true,
        "contentType": "binaryData",
        "bodyParameters": {
          "parameters": []
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": "={{ $('Extract Upload Info').item.json.putHeaders.map(h => ({ name: h.name, value: h.value })) }}"
        },
        "options": {}
      },
      "id": "b4c5d6e7-f8a9-4b0c-1d2e-3f4a5b6c7d8e",
      "name": "Step 2 - Upload to S3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 400],
      "notes": "Uploads the file content to S3 using the signed URL"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://{{ $('Set Clio Credentials').item.json.region }}.app.clio.com/api/v4/documents/{{ $('Extract Upload Info').item.json.documentId }}.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "clioApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,latest_document_version{fully_uploaded}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"uuid\": \"{{ $('Extract Upload Info').item.json.uuid }}\",\n    \"fully_uploaded\": true\n  }\n}",
        "options": {}
      },
      "id": "c5d6e7f8-a9b0-4c1d-2e3f-4a5b6c7d8e9f",
      "name": "Step 3 - Mark as Uploaded",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 400],
      "notes": "Marks the document as fully uploaded in Clio"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d6e7f8a9-b0c1-4d2e-3f4a-5b6c7d8e9f0a",
              "name": "region",
              "value": "eu",
              "type": "string"
            },
            {
              "id": "e7f8a9b0-c1d2-4e3f-4a5b-6c7d8e9f0a1b",
              "name": "accessToken",
              "value": "={{ $credentials.clioApi.accessToken }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "f8a9b0c1-d2e3-4f4a-5b6c-7d8e9f0a1b2c",
      "name": "Set Clio Credentials",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 120],
      "notes": "Set your Clio region (eu or us) and access token"
    }
  ],
  "pinData": {},
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [
        [
          {
            "node": "Set Input Parameters",
            "type": "main",
            "index": 0
          },
          {
            "node": "Set Clio Credentials",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Input Parameters": {
      "main": [
        [
          {
            "node": "Step 1 - Create Document Record",
            "type": "main",
            "index": 0
          },
          {
            "node": "Read Binary File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 1 - Create Document Record": {
      "main": [
        [
          {
            "node": "Extract Upload Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Upload Info": {
      "main": [
        [
          {
            "node": "Step 2 - Upload to S3",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Binary File": {
      "main": [
        [
          {
            "node": "Step 2 - Upload to S3",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Step 2 - Upload to S3": {
      "main": [
        [
          {
            "node": "Step 3 - Mark as Uploaded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "5e5d5e5d-5e5d-4e5d-5e5d-5e5d5e5d5e5d",
  "meta": {
    "instanceId": "your-instance-id"
  },
  "id": "1",
  "tags": []
}
